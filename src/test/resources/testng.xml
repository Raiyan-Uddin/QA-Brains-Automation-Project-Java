<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Beginner-friendly note:
  - Checkout and cart flows share server-side user state.
  - Running those classes in parallel can cause cross-test interference.
  - Keep full-suite execution sequential for stable pass/fail signals.
-->
<suite name="QA Brains E-Commerce - Automation Suite"
       verbose="1"
       parallel="none"
       thread-count="1">

    <listeners>
        <listener class-name="com.qabrains.utils.TestListener"/>
    </listeners>

    <!--
      Important for class-level parallel run:
      - Keep all classes under one <test> so TestNG can parallelize class execution.
      - BaseTest already isolates state using a fresh BrowserContext per test method.
    -->
    <test name="All Modules - Class Parallel Execution">
        <classes>
            <class name="com.qabrains.tests.login.LoginTests"/>
            <class name="com.qabrains.tests.home.HomeTests"/>
            <class name="com.qabrains.tests.productdetails.ProductDetailsTests"/>
            <class name="com.qabrains.tests.cart.CartTests"/>
            <class name="com.qabrains.tests.checkoutinfo.CheckoutInfoTests"/>
            <class name="com.qabrains.tests.checkoutoverview.CheckoutOverviewTests"/>
            <class name="com.qabrains.tests.checkoutcomplete.CheckoutCompleteTests"/>
        </classes>
    </test>

    <!--
      ♿ ACCESSIBILITY TESTING
      Comprehensive WCAG 2.1 Level AA compliance tests.
      These tests ensure the application is usable by all users including those
      with disabilities (blind, motor disabilities, low vision, cognitive disabilities).
      See docs/ACCESSIBILITY_TESTING.md for detailed documentation.
    -->
    <test name="Accessibility Testing - WCAG 2.1 Compliance">
        <classes>
            <class name="com.qabrains.tests.accessibility.AccessibilityTests"/>
        </classes>
    </test>

</suite>